---
const { title, description, stack = [], links = [], note } = Astro.props;
---

<article class="flex flex-col rounded-2xl border border-white/10 bg-white/5 p-6">
  <h3 class="text-xl font-semibold text-white">{title}</h3>
  <p class="mt-3 flex-1 text-slate-300">{description}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {stack.map((s) => (
      <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-slate-200">{s}</span>
    ))}
  </div>

  {links.length > 0 ? (
    <div class="mt-5 flex flex-wrap gap-4">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          class="font-medium text-teal-300 transition hover:text-teal-200"
        >
          {l.label} ↗
        </a>
      ))}
    </div>
  ) : (
    note && <p class="mt-5 text-sm text-slate-400">{note}</p>
  )}
</article>