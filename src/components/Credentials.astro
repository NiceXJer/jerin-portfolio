---
import { useTranslations, type Lang } from "../i18n/ui";

const { lang = "en" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

type Item = {
  id: string;
  title: string;
  issuer: string;
  badge?: string;
  image?: string;   // file inside public/certs/
  verify?: string;  // official verification link
};

const education: Item[] = [
  {
    id: "btech",
    title: "B.Tech in Electronics & Communication Engineering",
    issuer: "APJ Abdul Kalam Technological University",
    badge: "Anabin H+",
  },
];

const certs: Item[] = [
  {
    id: "telc",
    title: "telc Deutsch B2",
    issuer: "telc",
    badge: t("credentials.certified"),
  },
  {
    id: "cisco",
    title: "Cisco Network Fundamentals Specialization",
    issuer: "Coursera",
    image: "/certs/cisco-network-fundamentals.webp",
    verify: "https://www.coursera.org/account/accomplishments/specialization/DSULUALPBM1T", // TODO
  },
  {
    id: "google",
    title: "Google IT Support Professional Certificate",
    issuer: "Coursera",
    image: "/certs/google-it-support.webp",
    verify: "https://www.coursera.org/account/accomplishments/professional-cert/5B7A8RIX86FQ", // TODO
  },
];

const blocks = [
  { heading: t("credentials.education"), items: education },
  { heading: t("credentials.certs"), items: certs },
];

const withImages = certs.filter((c) => c.image);
---

<section id="credentials" class="mx-auto max-w-7xl px-6 pt-0 pb-0">
  <h2 class="mb-8 text-3xl font-bold">{t("credentials.heading")}</h2>

  <div class="grid gap-6 md:grid-cols-2">
    {blocks.map((b) => (
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="mb-5 text-xl font-semibold">{b.heading}</h3>
        <ul class="space-y-6">
          {b.items.map((i) => (
            <li class="flex gap-3">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-400"></span>
              <div>
                <p class="font-medium text-slate-100">{i.title}</p>
                <p class="mt-1 text-sm text-slate-300">
                  {i.issuer}
                  {i.badge && (
                    <span class="ml-2 rounded-full border border-teal-400/50 px-2 py-0.5 text-xs text-teal-300">
                      {i.badge}
                    </span>
                  )}
                </p>

                {(i.image || i.verify) && (
                  <div class="mt-3 flex flex-wrap gap-4 text-sm">
                    {i.image && (
                      <button
                        type="button"
                        data-open={i.id}
                        class="font-medium text-teal-300 transition hover:text-teal-200"
                      >
                        {t("credentials.view")}
                      </button>
                    )}
                    {i.verify && (
                      <a
                        href={i.verify}
                        target="_blank"
                        rel="noopener"
                        class="font-medium text-teal-300 transition hover:text-teal-200"
                      >
                        {t("credentials.verify")} ↗
                      </a>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {withImages.map((c) => (
    <dialog
      id={`dlg-${c.id}`}
      class="m-auto max-h-[90vh] w-[min(95vw,1000px)] rounded-2xl border border-white/10 bg-[#0b1426] p-4 text-slate-100 backdrop:bg-black/70"
    >
      <div class="mb-3 flex items-center justify-between gap-4">
        <p class="font-semibold">{c.title}</p>
        <button type="button" data-close class="rounded-lg border border-white/15 px-3 py-1 text-sm hover:bg-white/10">
          {t("credentials.close")}
        </button>
      </div>
      <img
        src={c.image}
        alt={c.title}
        loading="lazy"
        class="max-h-[75vh] w-full rounded-lg object-contain"
        draggable="false"
      />
    </dialog>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dlg = document.getElementById(`dlg-${btn.dataset.open}`) as HTMLDialogElement | null;
      dlg?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>("dialog").forEach((dlg) => {
    dlg.querySelector("[data-close]")?.addEventListener("click", () => dlg.close());
    // clicking the dark area outside the box closes it
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>