---
import { useTranslations, type Lang } from "../i18n/ui";

const { lang = "en" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const education = [
  {
    title: "B.Tech in Electronics & Communication Engineering",
    issuer: "APJ Abdul Kalam Technological University",
    badge: "Anabin H+",
  },
];

const certs = [
  { title: "telc Deutsch B2", issuer: "telc", badge: t("credentials.certified") },
  { title: "Cisco Network Fundamentals Specialization", issuer: "Coursera" },
  { title: "Google IT Support Professional Certificate", issuer: "Coursera" },
];

const blocks = [
  { heading: t("credentials.education"), items: education },
  { heading: t("credentials.certs"), items: certs },
];
---

<section id="credentials" class="mx-auto max-w-7xl px-6 py-16">
  <h2 class="mb-8 text-3xl font-bold">{t("credentials.heading")}</h2>

  <div class="grid gap-6 md:grid-cols-2">
    {blocks.map((b) => (
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="mb-5 text-xl font-semibold">{b.heading}</h3>
        <ul class="space-y-5">
          {b.items.map((i) => (
            <li class="flex gap-3">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-teal-400"></span>
              <div>
                <p class="font-medium text-slate-100">{i.title}</p>
                <p class="mt-1 text-sm text-slate-300">
                  {i.issuer}
                  {i.badge && (
                    <span class="ml-2 rounded-full border border-teal-400/50 px-2 py-0.5 text-xs text-teal-300">
                      {i.badge}
                    </span>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>