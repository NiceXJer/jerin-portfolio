---
import ProfilePhoto from "./ProfilePhoto.astro";
import { useTranslations, type Lang } from "../i18n/ui";

const { lang = "en" } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const github = "https://github.com/";
const linkedin = "https://www.linkedin.com/in/";
---

<section
  id="home"
  class="mx-auto grid max-w-7xl items-center gap-8 px-6 py-16 md:grid-cols-[1fr_auto] md:gap-4 md:py-24 lg:gap-0"
>
  <div>
    <h1 class="text-4xl font-bold text-teal-400 md:text-5xl lg:text-6xl">
      {t("hero.greeting")}
    </h1>
    <p class="mt-3 text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
      {t("hero.title")}
    </p>
    <p class="mt-6 max-w-2xl text-2xl font-light text-slate-300 lg:text-3xl">
      {t("hero.subtitle")}
    </p>
    <p
      class="mt-5 max-w-2xl text-lg text-slate-300 lg:text-xl [&_strong]:font-semibold [&_strong]:text-white"
      set:html={t("hero.body")}
    />

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/Lebenslauf_Jerin_George.pdf"
        download
        class="rounded-full bg-teal-400 px-8 py-4 text-lg font-semibold text-slate-900 shadow-lg shadow-teal-400/30 transition hover:bg-teal-300"
      >
        {t("hero.cv")}
      </a>
      <a href={github} target="_blank" rel="noopener"
        class="rounded-full border border-teal-400/60 px-7 py-4 text-lg text-teal-300 transition hover:bg-teal-400/10">
        GitHub
      </a>
      <a href={linkedin} target="_blank" rel="noopener"
        class="rounded-full border border-teal-400/60 px-7 py-4 text-lg text-teal-300 transition hover:bg-teal-400/10">
        LinkedIn
      </a>
    </div>
  </div>

  <div class="flex justify-center pt-12 md:-ml-6 md:justify-start md:pt-0 lg:-ml-10">
    <ProfilePhoto />
  </div>
</section>